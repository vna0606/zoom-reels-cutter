# Скопируйте этот файл в ".env" (в этой же папке) и при необходимости заполните.
# Файл .env не попадает в git — ключи остаются только на вашем компьютере.

# Ключ Deepgram (облачное распознавание речи, быстрее и точнее). Необязательно:
# без ключа автоматически используется локальный faster-whisper (медленнее, но бесплатно).
# Получить ключ: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ИИ-провайдер для монтажа: auto (по умолчанию) | claude | codex
# REEL_LLM_PROVIDER=claude

# Модель Claude: opus (по умолчанию, лучшее качество) | sonnet (быстрее и дешевле по лимитам)
# REEL_CLAUDE_MODEL=opus
